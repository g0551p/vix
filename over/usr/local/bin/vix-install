#!/bin/sh
set -eu

prog="${0##*/}"

usage() {
  cat <<EOF
usage: $prog <root> [disk]

  <root>  mounted target root filesystem
  [disk]  block device for BIOS install (e.g. /dev/sda)

  UEFI: mount the ESP at <root>/boot  (installed via --removable)
  BIOS: pass [disk]                    (no ESP required)

both can be combined.
EOF
  exit 1
}

[ "$(id -u)" -eq 0 ] || { echo "$prog: must be root" >&2; exit 1; }
root="${1:-}"
[ -n "$root" ] || usage
disk="${2:-}"

[ -d "$root" ] || { echo "$prog: $root: not a directory" >&2; exit 1; }
findmnt --mountpoint "$root" >/dev/null 2>&1 || { echo "$prog: $root: not mounted" >&2; exit 1; }

have_esp=no
if findmnt --mountpoint "$root/boot" >/dev/null 2>&1; then
  bootdev="$(findmnt -no SOURCE "$root/boot")"
  bootuuid="$(blkid -s UUID -o value "$bootdev")"
  bootfs="$(blkid -s TYPE -o value "$bootdev")"
  have_esp=yes
fi

if [ "$have_esp" = no ] && [ -z "$disk" ]; then
  echo "$prog: nothing to install - mount ESP at $root/boot (UEFI) or pass a disk (BIOS)" >&2
  exit 1
fi

[ -e /usr/lib/vix/vmlinuz ] || { echo "$prog: no /usr/lib/vix/vmlinuz (rebuild image)" >&2; exit 1; }

rootdev="$(findmnt -no SOURCE "$root")"
rootuuid="$(blkid -s UUID -o value "$rootdev")"
rootfs="$(blkid -s TYPE -o value "$rootdev")"

echo ">> copying system to $root (this takes a while)"
st="$(mktemp)"
trap 'rm -f "$st"' EXIT INT TERM
{
  if tar -C / --one-file-system \
    --exclude='./proc/*' --exclude='./sys/*' --exclude='./dev/*' \
    --exclude='./run/*' --exclude='./tmp/*' --exclude='./mnt/*' \
    --numeric-owner -cf - .; then
    echo 0 >"$st"
  else
    echo "$?" >"$st"
  fi
} | tar -C "$root" --numeric-owner -xf -
if [ "$(cat "$st")" -ne 0 ]; then
  echo "$prog: copy from live system failed (tar exit $(cat "$st")); $root is incomplete - installation aborted" >&2
  exit 1
fi

echo ">> fstab"
{
  printf 'UUID=%s\t/\t%s\tdefaults\t0 1\n' "$rootuuid" "$rootfs"
  [ "$have_esp" = yes ] && printf 'UUID=%s\t/boot\t%s\tdefaults\t0 2\n' "$bootuuid" "$bootfs"
} >"$root/etc/fstab"

echo ">> kernel + initrd"
mkdir -p "$root/boot"
cp "$root/usr/lib/vix/vmlinuz" "$root/boot/vmlinuz"
cp "$root/usr/lib/vix/initrd.img" "$root/boot/initrd.img"

echo ">> grub.cfg"
mkdir -p "$root/boot/grub"
cat >"$root/boot/grub/grub.cfg" <<EOF
set timeout=5
set default=0

menuentry "Vix" {
  linux /vmlinuz root=UUID=$rootuuid rw quiet
  initrd /initrd.img
}
EOF

if [ "$have_esp" = yes ]; then
  echo ">> grub-install (UEFI)"
  nix shell nixpkgs#grub2_efi -c grub-install \
    --target=x86_64-efi --efi-directory="$root/boot" --boot-directory="$root/boot" \
    --removable --no-nvram --recheck
fi

if [ -n "$disk" ]; then
  echo ">> grub-install (BIOS) -> $disk"
  nix shell nixpkgs#grub2 -c grub-install \
    --target=i386-pc --boot-directory="$root/boot" --recheck "$disk"
fi

echo ">> done. installed to $root; reboot when ready."
