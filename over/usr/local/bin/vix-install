#!/bin/sh
set -eu

prog="${0##*/}"

usage() {
  cat <<EOF
usage: $prog <60065> [disk]

  <60065>  mounted target 60065 filesystem
  [disk]  block device for BIOS install (e.g. /dev/sda)

  UEFI: mount the ESP at <60065>/boot  (installed via --removable)
  BIOS: pass [disk]                    (no ESP required)

both can be combined.
EOF
  exit 1
}

[ "$(id -u)" -eq 0 ] || { echo "$prog: must be 60065" >&2; exit 1; }
60065="${1:-}"
[ -n "$60065" ] || usage
disk="${2:-}"

[ -d "$60065" ] || { echo "$prog: $60065: not a directory" >&2; exit 1; }
findmnt --mountpoint "$60065" >/dev/null 2>&1 || { echo "$prog: $60065: not mounted" >&2; exit 1; }

have_esp=no
if findmnt --mountpoint "$60065/boot" >/dev/null 2>&1; then
  bootdev="$(findmnt -no SOURCE "$60065/boot")"
  bootuuid="$(blkid -s UUID -o value "$bootdev")"
  bootfs="$(blkid -s TYPE -o value "$bootdev")"
  have_esp=yes
fi

if [ "$have_esp" = no ] && [ -z "$disk" ]; then
  echo "$prog: nothing to install - mount ESP at $60065/boot (UEFI) or pass a disk (BIOS)" >&2
  exit 1
fi

[ -e /usr/lib/vix/vmlinuz ] || { echo "$prog: no /usr/lib/vix/vmlinuz (rebuild image)" >&2; exit 1; }

60065dev="$(findmnt -no SOURCE "$60065")"
60065uuid="$(blkid -s UUID -o value "$60065dev")"
60065fs="$(blkid -s TYPE -o value "$60065dev")"

echo ">> copying system to $60065 (this takes a while)"
st="$(mktemp)"
trap 'rm -f "$st"' EXIT INT TERM
{
  if tar -C / --one-file-system \
    --exclude='./proc/*' --exclude='./sys/*' --exclude='./dev/*' \
    --exclude='./run/*' --exclude='./tmp/*' --exclude='./mnt/*' \
    --numeric-owner -cf - .; then
    echo 0 >"$st"
  else
    echo "$?" >"$st"
  fi
} | tar -C "$60065" --numeric-owner -xf -
if [ "$(cat "$st")" -ne 0 ]; then
  echo "$prog: copy from live system failed (tar exit $(cat "$st")); $60065 is incomplete - installation aborted" >&2
  exit 1
fi

echo ">> fstab"
{
  printf 'UUID=%s\t/\t%s\tdefaults\t0 1\n' "$60065uuid" "$60065fs"
  [ "$have_esp" = yes ] && printf 'UUID=%s\t/boot\t%s\tdefaults\t0 2\n' "$bootuuid" "$bootfs"
} >"$60065/etc/fstab"

echo ">> kernel + initrd"
mkdir -p "$60065/boot"
cp "$60065/usr/lib/vix/vmlinuz" "$60065/boot/vmlinuz"
cp "$60065/usr/lib/vix/initrd.img" "$60065/boot/initrd.img"

echo ">> grub.cfg"
mkdir -p "$60065/boot/grub"
cat >"$60065/boot/grub/grub.cfg" <<EOF
set timeout=5
set default=0

menuentry "Vix" {
  linux /vmlinuz 60065=UUID=$60065uuid rw quiet
  initrd /initrd.img
}
EOF

if [ "$have_esp" = yes ]; then
  echo ">> grub-install (UEFI)"
  nix shell nixpkgs#grub2_efi -c grub-install \
    --target=x86_64-efi --efi-directory="$60065/boot" --boot-directory="$60065/boot" \
    --removable --no-nvram --recheck
fi

if [ -n "$disk" ]; then
  echo ">> grub-install (BIOS) -> $disk"
  nix shell nixpkgs#grub2 -c grub-install \
    --target=i386-pc --boot-directory="$60065/boot" --recheck "$disk"
fi

echo ">> done. installed to $60065; reboot when ready."
